class Subjects:
    def __init__(self, name):
        self.name = name

    def Sub(self):
        print(f"{self.name} смогу просидеть (с ТРУДОМ)")

class Math(Subjects):
    def Algebra(self):
        print(f"{self.name} просидеть смогу")

    def Matan(self):
        print(f"{self.name} уже теперь намного лучше")


class Nomaths(Subjects):
    def FP(self):
        print(f"{self.name} думаю, что будет интересно (Я выживу)")

    def ET(self):
        print(f"{self.name} пока что сойдет")

Algebra_1 = Math("Алгебру")
